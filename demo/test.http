POST http://localhost:8080/api/characters
Content-Type: application/json

{
  "name": "Dracule Mihawk",
  "description": "The world's strongest swordsman.",
  "universe": "One Piece",
  "role": "Shichibukai / Swordsman",
  "firstAppearance": "1997-07-22"
}

